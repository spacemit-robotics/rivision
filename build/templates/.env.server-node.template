# ============================================================
# RiVision Server Node (边缘节点) 配置模板
# 组件: rivision_worker + rivision_embed + rivision_infer
# 安装时自动复制为 /opt/rivision/shared/.env
# ============================================================

# ============ Worker 配置 ============
# Worker 监听端口
WORKER_PORT=9181
# ⚠️ 必须修改: Hub 地址 (中心服务器 Hub 端口)
HUB_URL=http://hub-ip:9280
# ⚠️ 必须修改: Gateway 地址 (中心服务器 Gateway 端口)
GATEWAY_URL=http://hub-ip:9090
# Worker 数据目录
WORKER_DATA_DIR=/opt/rivision/rivision_worker/data
# 节点 ID (首次安装时自动生成)
NODE_ID=

# ============ Infer 配置 ============
# gRPC 端口 (Worker 连接推理引擎)
INFER_GRPC_PORT=9091
# HTTP 调试端口 (可选)
INFER_HTTP_PORT=9092

# ============ Embedding 服务配置 (边缘侧写入向量化) ============
EMBED_HOST=127.0.0.1
EMBED_PORT=18081
EMBED_TEXT_MODEL=/opt/rivision/rivision_embed/models/cn_clip_text.onnx
EMBED_VISION_MODEL=/opt/rivision/rivision_embed/models/cn_clip_vision.onnx
# 推理线程数 (riscv64 / K3: 2-4)
EMBED_THREADS=4

# ============ go2rtc 流代理 ============
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_ENABLE=true
