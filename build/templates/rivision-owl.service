[Unit]
Description=RiVision OWL GB28181 Server
Documentation=https://github.com/RiVision/rivision-k3-deploy
After=network.target

[Service]
Type=simple
# User/Group 由 install.sh 替换为实际安装用户
User=RIVISION_USER_PLACEHOLDER
Group=RIVISION_GROUP_PLACEHOLDER
WorkingDirectory=/opt/rivision/rivision_owl
ExecStart=/opt/rivision/rivision_owl/bin/owl -c /opt/rivision/rivision_owl/config/
Restart=always
RestartSec=5
LimitNOFILE=65535
LimitNPROC=65535

# 环境变量（覆盖配置文件默认值，可按需调整）
Environment="OWL_HTTP_PORT=15123"
Environment="OWL_SIP_PORT=15060"
Environment="OWL_LOG_LEVEL=info"
Environment="OWL_LOG_DIR=/opt/rivision/rivision_owl/logs"
Environment="OWL_DATA_DIR=/opt/rivision/rivision_owl/data"
Environment="OWL_STORAGE_DIR=/opt/rivision/rivision_owl/recordings"
Environment="OWL_MEDIA_IP=127.0.0.1"
Environment="OWL_WEBHOOK_IP=127.0.0.1"
# OWL_SDP_IP: 国标收流地址，必须是可被设备访问的 IP
# 嵌入式 ZLM 模式下，此值决定 SIP INVITE 中 SDP c= 行地址
# 设备须能访问此 IP 才能接收 RTP 推流
Environment="OWL_SDP_IP=192.168.1.107"
Environment="ZLM_SECRET=eMkolBseFWMPJ8LgmRX2AVveRVtyZ0eN"
EnvironmentFile=-/opt/rivision/shared/.env
EnvironmentFile=-/opt/rivision/rivision_owl/config/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rivision-owl

[Install]
WantedBy=multi-user.target
