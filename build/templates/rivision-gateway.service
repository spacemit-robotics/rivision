[Unit]
Description=RiVision Gateway Service
After=network.target

[Service]
Type=simple
# User/Group 由 install.sh 替换为实际安装用户
User=RIVISION_USER_PLACEHOLDER
Group=RIVISION_GROUP_PLACEHOLDER
WorkingDirectory=/opt/rivision/rivision_gateway

EnvironmentFile=-/opt/rivision/shared/.env
EnvironmentFile=-/opt/rivision/rivision_gateway/config/.env

ExecStart=/opt/rivision/rivision_gateway/bin/rivision_gateway

Restart=always
RestartSec=5

# 资源限制
LimitNOFILE=65535
LimitNPROC=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rivision-gateway

[Install]
WantedBy=multi-user.target
