# ============================================================
# RiVision Server 端配置模板
# 组件: rivision_hub + rivision_gateway + rivision_owl
# 安装时自动复制为 /opt/rivision/shared/.env
# ============================================================

# ============ Hub 配置 ============
# Hub 监听端口 (Web API + WebSocket)
HUB_PORT=9280
# Hub 数据目录
HUB_DATA_DIR=/opt/rivision/rivision_hub/data
# Hub Web UI 目录 (rivision_app_web 构建产物)
HUB_WEB_DIR=/opt/rivision/rivision_hub/web

# ============ Gateway 配置 ============
# Gateway 监听地址/端口 (节点注册/心跳/Token认证)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9090
# 调试模式
GATEWAY_DEBUG=false
# 负载均衡策略: round_robin | random | least_conn | weighted
LOAD_BALANCE_STRATEGY=least_conn

# ============ 健康检查 ============
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# ============ 请求超时 (秒) ============
REQUEST_TIMEOUT=600
WAIT_TIMEOUT=600

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_ENABLE=true

# ============ Embedding 服务配置 (Hub 侧查询向量化) ============
# Hub 连接 Embedding 服务的 URL (可选, 用于联邦搜索查询向量化)
EMBED_URL=http://127.0.0.1:18081

# ============ OWL / ZLMediaKit 配置 ============
# OWL HTTP API 端口
OWL_HTTP_PORT=15123
# OWL SIP 端口 (GB28181 信令)
OWL_SIP_PORT=15060
# OWL 日志级别
OWL_LOG_LEVEL=info
# OWL SDP IP: 国标收流地址，必须是设备可访问的本机 IP
# 部署时必须修改为实际 LAN IP（不能用 127.0.0.1）
OWL_SDP_IP=
# ZLM HTTP API 密钥 (必须与 ZLM 二进制内置配置一致)
ZLM_SECRET=eMkolBseFWMPJ8LgmRX2AVveRVtyZ0eN
