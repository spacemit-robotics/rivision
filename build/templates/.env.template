# ============================================================
# RiVision Host 配置模板
# 安装时自动复制为 /opt/rivision/shared/.env
#
# 【重要】ZLM_SECRET 必须与 ZLM 二进制内置配置保持一致：
#   - 预编译 x86_64 ZLM 内置: eMkolBseFWMPJ8LgmRX2AVveRVtyZ0eN
#   - 部署者可自定义，但必须同步修改 ZLM 二进制内置配置
# ============================================================

# ============ CLI 配置 ============
# Web UI 监听端口
CLI_PORT=8280
# MP4 录像存储目录
CLI_MP4_DIR=/opt/rivision/rivision_cli/mp4path
# YOLO 推理模式: local | distributed
CLI_YOLO_MODE=distributed
# VLM 触发模式: manual | motion | interval
CLI_VLM_TRIGGER=interval

# ============ Gateway 配置 ============
# Gateway 监听地址
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081
# 调试模式
GATEWAY_DEBUG=false
# 负载均衡策略: round_robin | random | least_conn | weighted
LOAD_BALANCE_STRATEGY=least_conn

# ============ 健康检查 ============
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# ============ 请求超时 (秒) ============
REQUEST_TIMEOUT=600
WAIT_TIMEOUT=600

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_ENABLE=true

# ============ 限流配置 ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=1000
RATE_LIMIT_CONCURRENT=100

# ============ 数据目录 (各组件独立) ============
# CLI:     /opt/rivision/rivision_cli/mp4path
# Gateway: /opt/rivision/rivision_gateway/data (内部管理)
# OWL:     /opt/rivision/rivision_owl/data

# ============ OWL (GB28181) 配置 ============
OWL_ENABLED=true
OWL_URL=http://127.0.0.1:15123
OWL_USER=admin
OWL_PASS=admin
OWL_RSA=0
# SDP 对外宣告 IP (NAT/跨网段部署时必填，填本机局域网/公网可达 IP)
# 留空或 127.0.0.1 将导致 GB28181 设备无法向本机推流
OWL_SDP_IP=

# ============ ZLMediaKit 配置 ============
# 【重要】ZLM_SECRET 必须与 ZLM 二进制内置配置一致
ZLM_SECRET=eMkolBseFWMPJ8LgmRX2AVveRVtyZ0eN
# ZLM HTTP API 端口（默认: 8220，与 ZLM 预编译二进制内置值一致）
ZLM_HTTP_PORT=8220
ZLM_RTSP_PORT=5544
ZLM_RTMP_PORT=1935
ZLM_RTP_PROXY_PORT=10000

# ============ Embedding 服务配置 ============
# Embedding 服务监听地址
EMBED_HOST=127.0.0.1
EMBED_PORT=18081
# 模型路径
EMBED_TEXT_MODEL=/opt/rivision/rivision_embed/models/cn_clip_text.onnx
EMBED_VISION_MODEL=/opt/rivision/rivision_embed/models/cn_clip_vision.onnx
# 推理线程数 (x86: 4-8, riscv: 2-4)
EMBED_THREADS=4

# ============ CLI Embedding 配置 ============
# rivision-cli 连接 Embedding 服务的 URL
RIVISION_EMBED_URL=http://127.0.0.1:18081
RIVISION_EMBED_API_KEY=