# ============================================================
# RiVision Node 节点配置模板
# 复制为 /opt/rivision/rivision_node/config/.env 后根据实际环境修改
# ============================================================

# ============ 节点标识 ============
# 节点ID (留空=自动使用 node-{hostname})
NODE_ID=
# 负载均衡权重 (默认1, 高性能节点可设更高)
NODE_WEIGHT=1
# 节点标签 (逗号分隔)
NODE_TAGS=compute
# 节点IP地址 (auto=自动检测, 或手动指定如 10.3.82.137)
# ⚠️ 如果自动检测显示 127.0.0.1，请手动设置为节点的真实局域网 IP
NODE_HOST=auto

# ============ Gateway 配置 ============
# ⚠️ 必须修改为实际的 Gateway 地址
GATEWAY_URL=http://192.168.1.100:8081
# 心跳间隔 (秒)
HEARTBEAT_INTERVAL=15
# 注册Token (从Gateway Web界面获取，或留空使用默认)
REGISTRATION_TOKEN=

# ============ Node Agent 配置 ============
AGENT_HOST=0.0.0.0
AGENT_PORT=9090
LOG_LEVEL=INFO
LOG_ENABLE=true
LOG_FILE=logs/node-agent.log
LOG_BACKUP_COUNT=30

# ============ LLaMA 推理服务配置 ============
# 是否启用 LLaMA 服务 (true/false)
# node_yolo 类型节点应设为 false
LLAMA_ENABLED=true
# 当前使用的模型 (由 switch-model.sh 管理)
ACTIVE_MODEL=Qwen3VL
# 推理服务监听地址 (0.0.0.0=允许Gateway直接访问)
LLAMA_HOST=0.0.0.0
LLAMA_PORT=9080
# 推理线程数 (K3=8 使用全部 A100 NPU 核心, x86按核数)
LLAMA_THREADS=8
# 批处理线程数
LLAMA_BATCH_THREADS=8
# 并行请求数
LLAMA_PARALLEL=1
# 上下文长度
LLAMA_CTX_SIZE=4096
# 是否使用 Flash Attention
LLAMA_FLASH_ATTN=true
# CPU核心绑定 (K3 A100智算核: 8-15, x86留空=不绑定)
# 留空则脚本自动设置: riscv64 默认 8-15, x86 不绑定
LLAMA_CPU_AFFINITY=

# ============ YOLO 推理服务配置 ============
# 是否启用 YOLO 服务 (true/false)
# node_llama 类型节点应设为 false
YOLO_ENABLED=true
# YOLO Server 监听地址 (0.0.0.0=允许Gateway直接访问)
YOLO_HOST=0.0.0.0
YOLO_PORT=9081
# YOLO 模型文件名 (位于 models/ 目录)
# 留空则由 start-yolo.sh 按平台自动选择:
#   RISC-V (K3): 910byolo11n_b2.q.onnx (SpacemiT NPU 加速)
#   x86:         yolov8n.onnx
YOLO_MODEL=
# 置信度阈值 (0-1)
YOLO_CONF_THRESH=0.5
# NMS 阈值 (0-1)
YOLO_NMS_THRESH=0.45
# K3: YOLO_THREADS=4 → 4 个 A100 核心 (8-11)
# 多 Worker 并发 + 持续数据流 = 4 核 100% 利用率
YOLO_WORKERS=2
YOLO_THREADS=4
# 算子间并行度 (K3 建议 1-2，超过 4 会重置为 1)
YOLO_INTER_THREADS=1

# ============ 进程管理配置 ============
LLAMA_SERVICE_NAME=rivision-llama
LLAMA_PROCESS_NAME=llama-server
YOLO_SERVICE_NAME=rivision-yolo
YOLO_PROCESS_NAME=yolo-server

# ============ 路径配置 (通常不需要修改) ============
# 安装根目录
RIVISION_HOME=/opt/rivision/rivision_node
# llama.cpp 引擎目录
LLAMA_ENGINE_DIR=/opt/rivision/rivision_node/engines/llama.cpp
# 模型目录
MODELS_DIR=/opt/rivision/rivision_node/models
