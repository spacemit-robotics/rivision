# RiVision Gateway 配置
# 节点通过 Token 主动注册，无需静态配置文件
# ============================================================

# 服务监听地址
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081

# 数据目录 (Token、节点持久化)
DATA_DIR=/opt/rivision/rivision_gateway/data

# 负载均衡策略: round_robin | least_conn | weighted
LOAD_BALANCE_STRATEGY=least_conn

# 健康检查间隔 (秒)
HEALTH_CHECK_INTERVAL=30

# 请求超时 (秒) - VLM 推理可能需要较长时间
REQUEST_TIMEOUT=600

# 每节点最大并发数
MAX_CONCURRENT_PER_NODE=2

# 调试模式 (可选)
# DEBUG=true

# 节点发现网段 (可选，逗号分隔)
# DISCOVERY_RANGES=192.168.1.0/24,10.0.0.0/24
