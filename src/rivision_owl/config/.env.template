# RiVision OWL 环境变量配置
# 由 install.sh 根据环境变量自动生成
# 此文件为模板参考，请通过 install.sh 或手动编辑生成实际值
#
# 【重要】ZLM_SECRET 必须与 ZLM 二进制内置配置保持一致：
#   - 预编译 x86_64 ZLM 内置: eMkolBseFWMPJ8LgmRX2AVveRVtyZ0eN
#   - 部署者可自定义，但必须同步修改 ZLM 二进制内置配置

# ===== OWL 服务配置 =====
OWL_HTTP_PORT=15123
OWL_SIP_PORT=15060
OWL_USERNAME=admin
OWL_PASSWORD=admin
OWL_JWT_SECRET=
OWL_RTMP_SECRET=123

# ===== 日志配置 =====
OWL_LOG_LEVEL=info
OWL_LOG_DIR=/opt/rivision-owl/logs

# ===== 数据配置 =====
OWL_DATA_DIR=/opt/rivision-owl/data
OWL_STORAGE_DIR=/opt/rivision-owl/recordings

# ===== SIP 配置（GB28181 平台身份）=====
OWL_SIP_ID=34020000002000000001
OWL_SIP_DOMAIN=3402000000
OWL_SIP_PASSWORD=12345678

# ===== 媒体配置 =====
# OWL 监听 ZLM HTTP API 的地址（嵌入式时 ZLM 在本机，填 127.0.0.1）
OWL_MEDIA_IP=127.0.0.1
# ZLM WebHook 回调 OWL 的地址（OWL 监听的地址，供 ZLM 回调）
OWL_WEBHOOK_IP=127.0.0.1
# RTP 端口范围（ZLM RTP 收流用，格式: start-end）
OWL_RTP_PORT_RANGE=20000-20100

# ===== ZLMediaKit 配置 =====
ZLM_SECRET=eMkolBseFWMPJ8LgmRX2AVveRVtyZ0eN
ZLM_HTTP_PORT=8220
ZLM_RTSP_PORT=5544
ZLM_RTMP_PORT=11935
ZLM_RTP_PROXY_PORT=10000
ZLM_SERVER_ID=rivision-zlm

# ===== ZLMediaKit 高级配置（可选）=====
# ZLM_FFMPEG_BIN=/usr/bin/ffmpeg
# ZLM_STREAM_NONE_READER_DELAY_MS=20000
# OWL_SDP_IP=192.168.1.107  # 国标收流地址，必须填可被设备访问的 IP（不能是 127.0.0.1）
