+++ /tmp/rivision_owl_backup/owl/internal/zlm/manager.go	2026-04-08 14:20:12.000000000 +0800
@@ -0,0 +1,365 @@
+// Package zlm provides ZLMediaKit subprocess lifecycle management for OWL.
+//
+// Usage in main.go:
+//
+//	var noZLM = flag.Bool("no-zlm", false, "Skip embedded ZLM (expect external ZLM)")
+//	var zlmBin = flag.String("zlm-bin", "", "Path to external ZLM binary (default: embedded)")
+//
+//	func main() {
+//	    flag.Parse()
+//	    // ... config loading ...
+//
+//	    if !*noZLM {
+//	        mgr, err := zlm.Start(zlm.Config{
+//	            BinaryPath: *zlmBin, // empty = use embedded
+//	            Media:      &bc.Media,
+//	        })
+//	        if err != nil {
+//	            log.Printf("ZLM 启动失败: %v (继续，不影响 OWL 功能)", err)
+//	        } else {
+//	            defer mgr.Stop()
+//	        }
+//	    }
+//	    app.Run(&bc)
+//	}
+package zlm
+
+import (
+	"bytes"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/gowvp/owl/internal/conf"
+	"github.com/gowvp/owl/internal/embed"
+)
+
+// Config holds ZLM startup configuration.
+type Config struct {
+	// BinaryPath: ZLM binary path. Empty = use embedded binary.
+	BinaryPath string
+	// Media: OWL Media config (used to write ZLM config).
+	Media *conf.Media
+	// WorkDir: working directory for ZLM process (default: os.TempDir).
+	WorkDir string
+	// WaitTimeout: how long to wait for ZLM to become ready (default: 15s).
+	WaitTimeout time.Duration
+	// OWLHTTPPort: OWL's own HTTP port, used to register hooks.
+	OWLHTTPPort int
+}
+
+// Manager manages the ZLM subprocess lifecycle.
+type Manager struct {
+	cfg   Config
+	cmd   *exec.Cmd
+	pid   int
+	ready chan struct{}
+}
+
+// Secret returns the actual ZLM API secret (may differ from config if ZLM auto-generated it).
+// Only valid after WaitReady() has returned.
+func (m *Manager) Secret() string {
+	return m.cfg.Media.Secret
+}
+
+// Start launches ZLM as a subprocess and waits for it to become ready.
+// Returns a Manager that must be stopped on shutdown.
+// If no binary is found (neither external nor embedded), returns an error.
+func Start(cfg Config) (*Manager, error) {
+	if cfg.WaitTimeout == 0 {
+		cfg.WaitTimeout = 15 * time.Second
+	}
+	if cfg.WorkDir == "" {
+		cfg.WorkDir = os.TempDir()
+	}
+	if cfg.OWLHTTPPort == 0 {
+		cfg.OWLHTTPPort = 15123
+	}
+	if cfg.Media.HTTPPort == 0 {
+		cfg.Media.HTTPPort = 8220
+	}
+
+	binPath := cfg.BinaryPath
+
+	// Use embedded binary if not specified
+	if binPath == "" {
+		if !embed.HasEmbeddedBinary() {
+			return nil, fmt.Errorf("未找到嵌入的 ZLMediaKit 二进制，也未指定 -zlm-bin")
+		}
+		var err error
+		binPath, err = embed.ExtractBinary(filepath.Join(cfg.WorkDir, "owl-zlm"))
+		if err != nil {
+			return nil, fmt.Errorf("提取 ZLM 二进制失败: %w", err)
+		}
+		log.Printf("[ZLM] 使用嵌入的 ZLMediaKit: %s", embed.BinaryPath())
+	} else {
+		log.Printf("[ZLM] 使用外部 ZLMediaKit: %s", binPath)
+	}
+
+	// Generate ZLM config（使用固定路径 zlm.ini，方便 fetchActualSecret 读取）
+	cfgFilePath := filepath.Join(cfg.WorkDir, "zlm.ini")
+	if err := writeZLMConfig(&cfg, cfgFilePath); err != nil {
+		return nil, fmt.Errorf("生成 ZLM 配置文件失败: %w", err)
+	}
+
+	m := &Manager{cfg: cfg, ready: make(chan struct{})}
+
+	// Start ZLM subprocess
+	m.cmd = exec.Command(binPath, "-c", cfgFilePath)
+	m.cmd.Stdout = os.Stdout
+	m.cmd.Stderr = os.Stderr
+	m.cmd.Dir = cfg.WorkDir
+
+	if err := m.cmd.Start(); err != nil {
+		return nil, fmt.Errorf("启动 ZLM 进程失败: %w", err)
+	}
+	m.pid = m.cmd.Process.Pid
+	log.Printf("[ZLM] 已启动 (PID=%d), 等待就绪...", m.pid)
+
+	// Wait for ZLM HTTP API to respond
+	go m.waitReady(cfg.Media.HTTPPort)
+
+	return m, nil
+}
+
+// Stop terminates the ZLM subprocess.
+func (m *Manager) Stop() {
+	if m.cmd == nil || m.cmd.Process == nil {
+		return
+	}
+	log.Printf("[ZLM] 正在停止 (PID=%d)...", m.pid)
+
+	// SIGTERM first
+	_ = m.cmd.Process.Signal(syscall.SIGTERM)
+
+	// Give it 5s to exit gracefully
+	done := make(chan struct{})
+	go func() {
+		_ = m.cmd.Wait()
+		close(done)
+	}()
+
+	select {
+	case <-done:
+		log.Printf("[ZLM] 已停止")
+	case <-time.After(5 * time.Second):
+		log.Printf("[ZLM] SIGTERM 未响应，发送 SIGKILL")
+		_ = m.cmd.Process.Kill()
+		<-done
+		log.Printf("[ZLM] 已强制终止")
+	}
+}
+
+func (m *Manager) waitReady(httpPort int) {
+	url := fmt.Sprintf("http://127.0.0.1:%d/api/server/info", httpPort)
+	deadline := time.Now().Add(m.cfg.WaitTimeout)
+
+	client := &http.Client{Timeout: 2 * time.Second}
+	for time.Now().Before(deadline) {
+		resp, err := client.Get(url)
+		if err == nil {
+			resp.Body.Close()
+			if resp.StatusCode == 200 {
+				// ZLM is up — fetch actual secret in case ZLM auto-generated one
+				m.fetchActualSecret()
+				log.Printf("[ZLM] 就绪 (API 响应正常)")
+				close(m.ready)
+				return
+			}
+		}
+		time.Sleep(500 * time.Millisecond)
+	}
+	log.Printf("[ZLM] 等待就绪超时 (%.0fs)，继续启动 OWL", m.cfg.WaitTimeout.Seconds())
+	close(m.ready) // Don't block, continue anyway
+}
+
+// fetchActualSecret 从 ZLM dump 的配置文件中读取实际 secret
+// ZLM 启动时若 api.secret 无效会自动生成新的并写入 dump 文件
+func (m *Manager) fetchActualSecret() {
+	secret := m.cfg.Media.Secret
+
+	// 等待 ZLM dump 文件（最多 2s）
+	cfgFile := filepath.Join(m.cfg.WorkDir, "zlm.ini")
+	for i := 0; i < 20; i++ {
+		if data, err := os.ReadFile(cfgFile); err == nil {
+			// 解析 [api] secret=xxx
+			for _, line := range strings.Split(string(data), "\n") {
+				line = strings.TrimSpace(line)
+				if strings.HasPrefix(line, "secret=") {
+					actual := strings.TrimPrefix(line, "secret=")
+					if actual != "" && actual != secret {
+						log.Printf("[ZLM] 检测到 secret 不匹配，更新: %s -> %s", secret, actual)
+						m.cfg.Media.Secret = actual
+					}
+					return
+				}
+			}
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	log.Printf("[ZLM] 警告: 未在 %s 找到 secret，保留原值: %s", cfgFile, secret)
+}
+
+// WaitReady blocks until ZLM is ready or the wait times out.
+func (m *Manager) WaitReady() {
+	<-m.ready
+}
+
+// ─── Config file generation ─────────────────────────────────────────────────
+
+// writeZLMConfig 生成嵌入式 ZLM 子进程的运行时配置文件
+// 完整覆盖所有关键参数：端口、密钥、协议开关、FFmpeg、Webhook 等
+func writeZLMConfig(cfg *Config, cfgPath string) error {
+	workDir := cfg.WorkDir
+	if workDir == "" {
+		workDir = os.TempDir()
+	}
+
+	// Ensure directories exist
+	for _, dir := range []string{"www", "hls", "record", "ffmpeg/log", "snap"} {
+		_ = os.MkdirAll(filepath.Join(workDir, dir), 0755)
+	}
+
+	hookIP := cfg.Media.WebHookIP
+	if hookIP == "" {
+		hookIP = "127.0.0.1"
+	}
+
+	ffmpegBin := cfg.Media.FFmpegBin
+	if ffmpegBin == "" {
+		ffmpegBin = "/usr/bin/ffmpeg"
+	}
+
+	apiDebug := 0
+	if cfg.Media.APIDebug {
+		apiDebug = 1
+	}
+
+	streamNoneReaderDelayMS := cfg.Media.StreamNoneReaderDelayMS
+	if streamNoneReaderDelayMS == 0 {
+		streamNoneReaderDelayMS = 20000
+	}
+
+	zlmSecret := cfg.Media.Secret
+	if zlmSecret == "" {
+		zlmSecret = "eMkolBseFWMPJ8LgmRX2AVveRVtyZ0eN"
+	}
+
+	enableHLS := boolToInt(cfg.Media.EnableHLS, true)
+	enableFMP4 := boolToInt(cfg.Media.EnableFMP4, true)
+	enableRTSP := boolToInt(cfg.Media.EnableRTSP, true)
+	enableRTMP := boolToInt(cfg.Media.EnableRTMP, true)
+	enableMP4 := boolToInt(cfg.Media.EnableMP4Record, false)
+
+	sdpIP := cfg.Media.SDPIP
+	if sdpIP == "" {
+		sdpIP = cfg.Media.IP
+	}
+
+	var buf bytes.Buffer
+
+	// [api]
+	fmt.Fprintf(&buf, "[api]\n")
+	fmt.Fprintf(&buf, "apiDebug=%d\n", apiDebug)
+	fmt.Fprintf(&buf, "secret=%s\n", zlmSecret)
+	fmt.Fprintf(&buf, "snapRoot=./snap/\n")
+	fmt.Fprintf(&buf, "defaultSnap=./snap/default.jpg\n\n")
+
+	// [ffmpeg]
+	fmt.Fprintf(&buf, "[ffmpeg]\n")
+	fmt.Fprintf(&buf, "bin=%s\n", ffmpegBin)
+	fmt.Fprintf(&buf, "snap=-i %%s -y -f mjpeg -frames:v 1 %%s\n")
+	fmt.Fprintf(&buf, "log=./ffmpeg/log/\n")
+	fmt.Fprintf(&buf, "restartSec=0\n\n")
+
+	// [general]
+	fmt.Fprintf(&buf, "[general]\n")
+	fmt.Fprintf(&buf, "mediaServerId=owl-zlm-%s\n", cfg.Media.IP)
+	fmt.Fprintf(&buf, "listen_ip=0.0.0.0\n")
+	fmt.Fprintf(&buf, "enableVhost=0\n")
+	fmt.Fprintf(&buf, "maxStreamWaitMS=15000\n")
+	fmt.Fprintf(&buf, "streamNoneReaderDelayMS=%d\n", streamNoneReaderDelayMS)
+	fmt.Fprintf(&buf, "enableAudio=1\n")
+	fmt.Fprintf(&buf, "addMuteAudio=1\n")
+	fmt.Fprintf(&buf, "enableHls=%d\n", enableHLS)
+	fmt.Fprintf(&buf, "enableFMP4=%d\n", enableFMP4)
+	fmt.Fprintf(&buf, "enableRtsp=%d\n", enableRTSP)
+	fmt.Fprintf(&buf, "enableRtmp=%d\n", enableRTMP)
+	fmt.Fprintf(&buf, "enableMP4=%d\n\n", enableMP4)
+
+	// [hook]
+	fmt.Fprintf(&buf, "[hook]\n")
+	fmt.Fprintf(&buf, "admin_params=secret=%s\n", zlmSecret)
+	fmt.Fprintf(&buf, "enable=1\n")
+	fmt.Fprintf(&buf, "on_flow_report=\n")
+	fmt.Fprintf(&buf, "on_http_access=\n")
+	fmt.Fprintf(&buf, "on_play=\n")
+	fmt.Fprintf(&buf, "on_publish=\n")
+	fmt.Fprintf(&buf, "on_record_mp4=\n")
+	fmt.Fprintf(&buf, "on_record_ts=\n")
+	fmt.Fprintf(&buf, "on_rtsp_auth=\n")
+	fmt.Fprintf(&buf, "on_rtsp_realm=\n")
+	fmt.Fprintf(&buf, "on_shell_login=\n")
+	fmt.Fprintf(&buf, "on_server_started=http://%s:%d/webhook/on_server_started\n", hookIP, cfg.OWLHTTPPort)
+	fmt.Fprintf(&buf, "on_stream_changed=http://%s:%d/webhook/on_stream_changed\n", hookIP, cfg.OWLHTTPPort)
+	fmt.Fprintf(&buf, "on_stream_none_reader=http://%s:%d/webhook/on_stream_none_reader\n", hookIP, cfg.OWLHTTPPort)
+	fmt.Fprintf(&buf, "on_stream_not_found=http://%s:%d/webhook/on_stream_not_found\n", hookIP, cfg.OWLHTTPPort)
+	fmt.Fprintf(&buf, "timeoutSec=10\n")
+	fmt.Fprintf(&buf, "alive_interval=30\n\n")
+
+	// [http]
+	fmt.Fprintf(&buf, "[http]\n")
+	fmt.Fprintf(&buf, "port=%d\n", cfg.Media.HTTPPort)
+	fmt.Fprintf(&buf, "sslport=0\n")   // 禁用 HTTPS（需要证书，不启用）
+	fmt.Fprintf(&buf, "rootPath=./www\n\n")
+
+	// [rtmp]
+	fmt.Fprintf(&buf, "[rtmp]\n")
+	fmt.Fprintf(&buf, "port=11935\n")
+	fmt.Fprintf(&buf, "sslport=19350\n\n")
+
+	// [rtsp]
+	fmt.Fprintf(&buf, "[rtsp]\n")
+	fmt.Fprintf(&buf, "authBasic=0\n")
+	fmt.Fprintf(&buf, "directProxy=1\n")
+	fmt.Fprintf(&buf, "handshakeSecond=15\n")
+	fmt.Fprintf(&buf, "keepAliveSecond=15\n")
+	fmt.Fprintf(&buf, "port=5544\n")
+	fmt.Fprintf(&buf, "sslport=5322\n\n")
+
+	// [rtp_proxy] 使用完整的 port_range 而非单个 port
+	fmt.Fprintf(&buf, "[rtp_proxy]\n")
+	rtpPortRange := cfg.Media.RTPPortRange
+	if rtpPortRange == "" {
+		rtpPortRange = "20000-20100"
+	}
+	fmt.Fprintf(&buf, "port_range=%s\n", rtpPortRange)
+	fmt.Fprintf(&buf, "timeoutSec=15\n\n")
+
+	return os.WriteFile(cfgPath, []byte(buf.String()), 0644)
+}
+
+// boolToInt 将 bool 转换为 int（1/0），支持默认值
+func boolToInt(b bool, defaultVal bool) int {
+	if b == defaultVal {
+		return 1
+	}
+	return 0
+}
+
+func parseRTPPortStart(r string) string {
+	if r == "" {
+		return "10000"
+	}
+	parts := strings.SplitN(r, "-", 2)
+	if len(parts) >= 1 {
+		return strings.TrimSpace(parts[0])
+	}
+	return "10000"
+}
