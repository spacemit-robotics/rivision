@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+import base64
+import json
+import subprocess
+
+BASE = "http://127.0.0.1:15123"
+
+# 1. 获取 RSA 公钥
+key_b64 = subprocess.check_output(["curl", "-s", f"{BASE}/login/key"]).decode()
+pub_key_pem = base64.b64decode(json.loads(key_b64)["key"]).decode()
+credentials = {"username": "admin", "password": "admin"}
+plaintext = json.dumps(credentials).encode()
+
+from cryptography.hazmat.primitives.asymmetric import padding as rsa_padding
+from cryptography.hazmat.primitives import hashes
+from cryptography.hazmat.primitives.serialization import load_pem_public_key
+from cryptography.hazmat.backends import default_backend
+
+pub_key = load_pem_public_key(pub_key_pem.encode(), backend=default_backend())
+ciphertext = pub_key.encrypt(plaintext, rsa_padding.OAEP(
+    mgf=rsa_padding.MGF1(algorithm=hashes.SHA256()),
+    algorithm=hashes.SHA256(),
+    label=None
+))
+data = base64.b64encode(ciphertext).decode()
+
+# 2. 登录
+login_resp = subprocess.check_output([
+    "curl", "-s", "-X", "POST", f"{BASE}/login",
+    "-H", "Content-Type: application/json",
+    "-d", json.dumps({"data": data})
+]).decode()
+token = json.loads(login_resp)["token"]
+print(f"登录成功，token: {token[:60]}...")
+print()
+
+# 3. 查询通道列表
+ch_list = subprocess.check_output([
+    "curl", "-s", f"{BASE}/channels",
+    "-H", f"Authorization: Bearer {token}"
+]).decode()
+items = json.loads(ch_list).get("items", [])
+print(f"发现 {len(items)} 个通道:")
+for ch in items:
+    print(f"  内部ID={ch['id']}  设备ID={ch['device_id']}  通道ID={ch['channel_id']}  名称={ch['name']}  类型={ch['type']}")
+print()
+
+# 4. 用实际通道 ID 播放
+actual_id = items[0]["id"] if items else None
+if actual_id:
+    play_resp = subprocess.check_output([
+        "curl", "-s", "-X", "POST",
+        f"{BASE}/channels/{actual_id}/play",
+        "-H", f"Authorization: Bearer {token}"
+    ]).decode()
+    print(f"--- 播放请求 (通道={actual_id}) ---")
+    print(play_resp)
+else:
+    print("没有可用通道")
