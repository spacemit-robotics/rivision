diff -ruN '--exclude=.git' '--exclude=node_modules' '--exclude=dist' '--exclude=build' '--exclude=data' '--exclude=logs' '--exclude=tmp' '--exclude=cover' src/rivision_owl/owl/internal/embed/embed.go /tmp/rivision_owl_backup/owl/internal/embed/embed.go
--- src/rivision_owl/owl/internal/embed/embed.go	1970-01-01 08:00:00.000000000 +0800
+++ /tmp/rivision_owl_backup/owl/internal/embed/embed.go	2026-04-04 22:48:08.000000000 +0800
@@ -0,0 +1,63 @@
+// Package embed provides embedded binary management for ZLMediaKit.
+//
+// Design:
+//   - ZLMediaKit is embedded as a binary alongside the OWL binary
+//   - At startup, OWL extracts the ZLM binary to a temp/work directory
+//   - OWL then starts ZLM as a subprocess and manages its lifecycle
+//   - If -no-zlm is passed, OWL skips ZLM startup (expects external ZLM)
+//
+// Build requirements:
+//   - Place ZLMediaKit binary in internal/embed/binaries/ before building
+//   - Naming: ZLMediaKit-linux-amd64, ZLMediaKit-linux-riscv64
+package embed
+
+import (
+	"embed"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+)
+
+//go:embed binaries/ZLMediaKit-*
+var fs embed.FS
+
+// GetBinaryName returns the platform-specific ZLMediaKit binary name.
+func GetBinaryName() string {
+	goos := runtime.GOOS
+	goarch := runtime.GOARCH
+	return fmt.Sprintf("ZLMediaKit-%s-%s", goos, goarch)
+}
+
+// HasEmbeddedBinary returns true if a binary for the current platform is embedded.
+func HasEmbeddedBinary() bool {
+	_, err := fs.ReadFile(filepath.Join("binaries", GetBinaryName()))
+	return err == nil
+}
+
+// ExtractBinary extracts the embedded ZLMediaKit binary to destDir.
+func ExtractBinary(destDir string) (string, error) {
+	binaryName := GetBinaryName()
+	srcPath := filepath.Join("binaries", binaryName)
+
+	data, err := fs.ReadFile(srcPath)
+	if err != nil {
+		return "", fmt.Errorf("未找到当前平台的 ZLMediaKit 二进制 (%s): %w", binaryName, err)
+	}
+
+	if err := os.MkdirAll(destDir, 0755); err != nil {
+		return "", fmt.Errorf("创建目录失败: %w", err)
+	}
+
+	destPath := filepath.Join(destDir, "MediaServer")
+	if err := os.WriteFile(destPath, data, 0755); err != nil {
+		return "", fmt.Errorf("写入文件失败: %w", err)
+	}
+
+	return destPath, nil
+}
+
+// BinaryPath returns the embedded binary path for inspection.
+func BinaryPath() string {
+	return filepath.Join("binaries", GetBinaryName())
+}
