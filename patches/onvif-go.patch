+// Package server provides ONVIF server implementation for testing and simulation.
+// This file implements ONVIF Event Service with PullPoint subscription.
+package server
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/0x524a/onvif-go/server/soap"
+)
+
+// Event service constants
+const (
+	// Default subscription termination time (60 seconds)
+	defaultTerminationTime = 60 * time.Second
+	// Maximum message limit per pull
+	maxMessageLimit = 100
+	// Default pull timeout
+	defaultPullTimeout = 30 * time.Second
+)
+
+// EventService handles ONVIF Event Service operations.
+type EventService struct {
+	server        *Server
+	subscriptions map[string]*PullPointSubscription
+	mutex         sync.RWMutex
+	eventQueue    map[string][]NotificationMessage
+}
+
+// PullPointSubscription represents an active PullPoint subscription.
+type PullPointSubscription struct {
+	SubscriptionID   string
+	ConsumerRef      string
+	Filter           string
+	InitialTermTime  time.Time
+	CurrentTermTime  time.Time
+	CreatedAt        time.Time
+	LastPullAt       time.Time
+	MessageCount     int
+}
+
+// NotificationMessage represents an event notification.
+type NotificationMessage struct {
+	Topic        string
+	ProducerRef  string
+	Message      EventMessage
+	UtcTime      time.Time
+	PropertyOp   string // "Initialized", "Changed", "Deleted"
+}
+
+// EventMessage contains event data.
+type EventMessage struct {
+	Source SimpleItem
+	Data   SimpleItem
+}
+
+// SimpleItem represents a simple name-value pair.
+type SimpleItem struct {
+	Name  string
+	Value string
+}
+
+// NewEventService creates a new Event Service.
+func NewEventService(server *Server) *EventService {
+	return &EventService{
+		server:        server,
+		subscriptions: make(map[string]*PullPointSubscription),
+		eventQueue:    make(map[string][]NotificationMessage),
+	}
+}
+
+// RegisterEventService registers the event service handlers.
+func (s *Server) registerEventService(mux *http.ServeMux) {
+	eventService := NewEventService(s)
+	handler := soap.NewHandler(s.config.Username, s.config.Password)
+
+	// Register event service handlers
+	handler.RegisterHandler("GetServiceCapabilities", eventService.HandleGetServiceCapabilities)
+	handler.RegisterHandler("CreatePullPointSubscription", eventService.HandleCreatePullPointSubscription)
+	handler.RegisterHandler("PullMessages", eventService.HandlePullMessages)
+	handler.RegisterHandler("Unsubscribe", eventService.HandleUnsubscribe)
+	handler.RegisterHandler("Renew", eventService.HandleRenew)
+	handler.RegisterHandler("GetEventProperties", eventService.HandleGetEventProperties)
+
+	mux.Handle(s.config.BasePath+"/event_service", handler)
+}
+
+// XML request/response structures for Event Service
+
+// GetServiceCapabilitiesResponse represents the response.
+type EventServiceCapabilitiesResponse struct {
+	XMLName      xml.Name                  `xml:"http://www.onvif.org/ver10/events/wsdl GetServiceCapabilitiesResponse"`
+	Capabilities EventServiceCapabilities  `xml:"Capabilities"`
+}
+
+// EventServiceCapabilities represents event service capabilities.
+type EventServiceCapabilities struct {
+	WSSubscriptionPolicySupport                   bool `xml:"WSSubscriptionPolicySupport,attr"`
+	WSPullPointSupport                            bool `xml:"WSPullPointSupport,attr"`
+	WSPausableSubscriptionManagerInterfaceSupport bool `xml:"WSPausableSubscriptionManagerInterfaceSupport,attr"`
+	MaxNotificationProducers                      int  `xml:"MaxNotificationProducers,attr"`
+	MaxPullPoints                                 int  `xml:"MaxPullPoints,attr"`
+	PersistentNotificationStorage                 bool `xml:"PersistentNotificationStorage,attr"`
+}
+
+// CreatePullPointSubscriptionRequest represents the request.
+type CreatePullPointSubscriptionRequest struct {
+	XMLName                 xml.Name `xml:"http://www.onvif.org/ver10/events/wsdl CreatePullPointSubscription"`
+	Filter                  string   `xml:"Filter,omitempty"`
+	InitialTerminationTime  string   `xml:"InitialTerminationTime,omitempty"`
+	SubscriptionPolicy      string   `xml:"SubscriptionPolicy,omitempty"`
+}
+
+// CreatePullPointSubscriptionResponse represents the response.
+type CreatePullPointSubscriptionResponse struct {
+	XMLName             xml.Name `xml:"http://www.onvif.org/ver10/events/wsdl CreatePullPointSubscriptionResponse"`
+	SubscriptionReference SubscriptionReference `xml:"SubscriptionReference"`
+	CurrentTime         string   `xml:"http://docs.oasis-open.org/wsn/b-2 CurrentTime"`
+	TerminationTime     string   `xml:"http://docs.oasis-open.org/wsn/b-2 TerminationTime"`
+}
+
+// SubscriptionReference contains the subscription endpoint.
+type SubscriptionReference struct {
+	Address string `xml:"http://www.w3.org/2005/08/addressing Address"`
+}
+
+// PullMessagesRequest represents the request.
+type PullMessagesRequest struct {
+	XMLName      xml.Name `xml:"http://www.onvif.org/ver10/events/wsdl PullMessages"`
+	Timeout      string   `xml:"Timeout"`
+	MessageLimit int      `xml:"MessageLimit"`
+}
+
+// PullMessagesResponse represents the response.
+type PullMessagesResponse struct {
+	XMLName             xml.Name              `xml:"http://www.onvif.org/ver10/events/wsdl PullMessagesResponse"`
+	CurrentTime         string                `xml:"CurrentTime"`
+	TerminationTime     string                `xml:"TerminationTime"`
+	NotificationMessage []NotificationMsgXML  `xml:"http://docs.oasis-open.org/wsn/b-2 NotificationMessage,omitempty"`
+}
+
+// NotificationMsgXML is the XML representation of a notification.
+type NotificationMsgXML struct {
+	Topic   TopicXML   `xml:"Topic"`
+	Message MessageXML `xml:"Message"`
+}
+
+// TopicXML represents the topic element.
+type TopicXML struct {
+	Dialect string `xml:"Dialect,attr"`
+	Topic   string `xml:",chardata"`
+}
+
+// MessageXML represents the message element.
+type MessageXML struct {
+	UtcTime    string `xml:"UtcTime,attr"`
+	PropertyOp string `xml:"PropertyOperation,attr,omitempty"`
+	Source     SourceXML `xml:"Source,omitempty"`
+	Data       DataXML   `xml:"Data,omitempty"`
+}
+
+// SourceXML represents the source element.
+type SourceXML struct {
+	SimpleItem []SimpleItemXML `xml:"SimpleItem,omitempty"`
+}
+
+// DataXML represents the data element.
+type DataXML struct {
+	SimpleItem []SimpleItemXML `xml:"SimpleItem,omitempty"`
+}
+
+// SimpleItemXML represents a simple item element.
+type SimpleItemXML struct {
+	Name  string `xml:"Name,attr"`
+	Value string `xml:"Value,attr"`
+}
+
+// UnsubscribeRequest represents the request.
+type UnsubscribeRequest struct {
+	XMLName xml.Name `xml:"http://docs.oasis-open.org/wsn/b-2 Unsubscribe"`
+}
+
+// UnsubscribeResponse represents the response.
+type UnsubscribeResponse struct {
+	XMLName xml.Name `xml:"http://docs.oasis-open.org/wsn/b-2 UnsubscribeResponse"`
+}
+
+// RenewRequest represents the request.
+type RenewRequest struct {
+	XMLName         xml.Name `xml:"http://docs.oasis-open.org/wsn/b-2 Renew"`
+	TerminationTime string   `xml:"TerminationTime"`
+}
+
+// RenewResponse represents the response.
+type RenewResponse struct {
+	XMLName         xml.Name `xml:"http://docs.oasis-open.org/wsn/b-2 RenewResponse"`
+	TerminationTime string   `xml:"TerminationTime"`
+	CurrentTime     string   `xml:"CurrentTime"`
+}
+
+// GetEventPropertiesRequest represents the request.
+type GetEventPropertiesRequest struct {
+	XMLName xml.Name `xml:"http://www.onvif.org/ver10/events/wsdl GetEventProperties"`
+}
+
+// GetEventPropertiesResponse represents the response.
+type GetEventPropertiesResponse struct {
+	XMLName                       xml.Name `xml:"http://www.onvif.org/ver10/events/wsdl GetEventPropertiesResponse"`
+	TopicNamespaceLocation        []string `xml:"TopicNamespaceLocation"`
+	FixedTopicSet                 bool     `xml:"http://docs.oasis-open.org/wsn/b-2 FixedTopicSet"`
+	TopicSet                      TopicSetXML `xml:"http://docs.oasis-open.org/wsn/t-1 TopicSet"`
+	TopicExpressionDialect        []string `xml:"http://docs.oasis-open.org/wsn/b-2 TopicExpressionDialect"`
+	MessageContentFilterDialect   []string `xml:"MessageContentFilterDialect"`
+	MessageContentSchemaLocation  []string `xml:"MessageContentSchemaLocation"`
+}
+
+// TopicSetXML represents the topic set.
+type TopicSetXML struct {
+	Device DeviceTopicXML `xml:"http://www.onvif.org/ver10/topics Device,omitempty"`
+}
+
+// DeviceTopicXML represents device topics.
+type DeviceTopicXML struct {
+	Trigger TriggerTopicXML `xml:"Trigger,omitempty"`
+}
+
+// TriggerTopicXML represents trigger topics.
+type TriggerTopicXML struct {
+	DigitalInput string `xml:"DigitalInput,omitempty"`
+}
+
+// Handler implementations
+
+// HandleGetServiceCapabilities handles GetServiceCapabilities request.
+func (e *EventService) HandleGetServiceCapabilities(body interface{}) (interface{}, error) {
+	return &EventServiceCapabilitiesResponse{
+		Capabilities: EventServiceCapabilities{
+			WSSubscriptionPolicySupport:                   false,
+			WSPullPointSupport:                            true,
+			WSPausableSubscriptionManagerInterfaceSupport: false,
+			MaxNotificationProducers:                      10,
+			MaxPullPoints:                                 10,
+			PersistentNotificationStorage:                 false,
+		},
+	}, nil
+}
+
+// HandleCreatePullPointSubscription handles CreatePullPointSubscription request.
+func (e *EventService) HandleCreatePullPointSubscription(body interface{}) (interface{}, error) {
+	e.mutex.Lock()
+	defer e.mutex.Unlock()
+
+	// Generate subscription ID
+	subscriptionID := generateSubscriptionID()
+
+	// Calculate termination time
+	termTime := time.Now().Add(defaultTerminationTime)
+
+	// Create subscription
+	subscription := &PullPointSubscription{
+		SubscriptionID:  subscriptionID,
+		InitialTermTime: termTime,
+		CurrentTermTime: termTime,
+		CreatedAt:       time.Now(),
+		LastPullAt:      time.Now(),
+	}
+
+	e.subscriptions[subscriptionID] = subscription
+	e.eventQueue[subscriptionID] = make([]NotificationMessage, 0)
+
+	// Build subscription reference URL
+	host := e.server.config.Host
+	if host == "0.0.0.0" || host == "" {
+		host = "localhost"
+	}
+	subRef := fmt.Sprintf("http://%s:%d%s/event_service?subscription=%s",
+		host, e.server.config.Port, e.server.config.BasePath, subscriptionID)
+
+	return &CreatePullPointSubscriptionResponse{
+		SubscriptionReference: SubscriptionReference{
+			Address: subRef,
+		},
+		CurrentTime:     time.Now().UTC().Format(time.RFC3339),
+		TerminationTime: termTime.UTC().Format(time.RFC3339),
+	}, nil
+}
+
+// HandlePullMessages handles PullMessages request.
+func (e *EventService) HandlePullMessages(body interface{}) (interface{}, error) {
+	e.mutex.Lock()
+	defer e.mutex.Unlock()
+
+	// For simplicity, return empty messages (no events)
+	// In a real implementation, this would return queued events
+	now := time.Now()
+	termTime := now.Add(defaultTerminationTime)
+
+	return &PullMessagesResponse{
+		CurrentTime:         now.UTC().Format(time.RFC3339),
+		TerminationTime:     termTime.UTC().Format(time.RFC3339),
+		NotificationMessage: []NotificationMsgXML{},
+	}, nil
+}
+
+// HandleUnsubscribe handles Unsubscribe request.
+func (e *EventService) HandleUnsubscribe(body interface{}) (interface{}, error) {
+	// In a full implementation, we would parse the subscription ID from the request
+	// For now, just return success
+	return &UnsubscribeResponse{}, nil
+}
+
+// HandleRenew handles Renew request.
+func (e *EventService) HandleRenew(body interface{}) (interface{}, error) {
+	now := time.Now()
+	termTime := now.Add(defaultTerminationTime)
+
+	return &RenewResponse{
+		CurrentTime:     now.UTC().Format(time.RFC3339),
+		TerminationTime: termTime.UTC().Format(time.RFC3339),
+	}, nil
+}
+
+// HandleGetEventProperties handles GetEventProperties request.
+func (e *EventService) HandleGetEventProperties(body interface{}) (interface{}, error) {
+	return &GetEventPropertiesResponse{
+		TopicNamespaceLocation: []string{
+			"http://www.onvif.org/onvif/ver10/topics/topicns.xml",
+		},
+		FixedTopicSet: true,
+		TopicSet: TopicSetXML{
+			Device: DeviceTopicXML{
+				Trigger: TriggerTopicXML{
+					DigitalInput: "tns1:Device/Trigger/DigitalInput",
+				},
+			},
+		},
+		TopicExpressionDialect: []string{
+			"http://www.onvif.org/ver10/tev/topicExpression/ConcreteSet",
+			"http://docs.oasis-open.org/wsn/t-1/TopicExpression/Concrete",
+		},
+		MessageContentFilterDialect: []string{
+			"http://www.onvif.org/ver10/tev/messageContentFilter/ItemFilter",
+		},
+		MessageContentSchemaLocation: []string{
+			"http://www.onvif.org/onvif/ver10/schema/onvif.xsd",
+		},
+	}, nil
+}
+
+// PushEvent adds an event to all active subscriptions.
+func (e *EventService) PushEvent(topic string, source, data SimpleItem) {
+	e.mutex.Lock()
+	defer e.mutex.Unlock()
+
+	msg := NotificationMessage{
+		Topic:       topic,
+		ProducerRef: fmt.Sprintf("http://%s:%d", e.server.config.Host, e.server.config.Port),
+		Message: EventMessage{
+			Source: source,
+			Data:   data,
+		},
+		UtcTime:    time.Now().UTC(),
+		PropertyOp: "Changed",
+	}
+
+	// Add to all subscription queues
+	for subID := range e.subscriptions {
+		e.eventQueue[subID] = append(e.eventQueue[subID], msg)
+		// Limit queue size
+		if len(e.eventQueue[subID]) > maxMessageLimit {
+			e.eventQueue[subID] = e.eventQueue[subID][1:]
+		}
+	}
+}
+
+// CleanupExpiredSubscriptions removes expired subscriptions.
+func (e *EventService) CleanupExpiredSubscriptions() {
+	e.mutex.Lock()
+	defer e.mutex.Unlock()
+
+	now := time.Now()
+	for id, sub := range e.subscriptions {
+		if now.After(sub.CurrentTermTime) {
+			delete(e.subscriptions, id)
+			delete(e.eventQueue, id)
+		}
+	}
+}
+
+// generateSubscriptionID generates a unique subscription ID.
+func generateSubscriptionID() string {
+	return generateDeviceUUID()
+}
