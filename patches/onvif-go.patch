+// Package server provides ONVIF server implementation for testing and simulation.
+// This file implements WS-Discovery 1.1 responder for ONVIF device discovery.
+package server
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/xml"
+	"fmt"
+	"log"
+	"net"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/net/ipv4"
+)
+
+// WS-Discovery constants per WS-Discovery 1.1 specification
+const (
+	// WSDiscoveryMulticastAddr is the IPv4 multicast address for WS-Discovery
+	WSDiscoveryMulticastAddr = "239.255.255.250:3702"
+
+	// WS-Discovery actions
+	wsaProbeAction      = "http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe"
+	wsaProbeMatchAction = "http://schemas.xmlsoap.org/ws/2005/04/discovery/ProbeMatches"
+	wsaHelloAction      = "http://schemas.xmlsoap.org/ws/2005/04/discovery/Hello"
+	wsaByeAction        = "http://schemas.xmlsoap.org/ws/2005/04/discovery/Bye"
+
+	// WS-Discovery anonymous address
+	wsaAnonymousAddr = "http://schemas.xmlsoap.org/ws/2004/08/addressing/role/anonymous"
+
+	// ONVIF device types
+	onvifNetworkVideoTransmitter = "dn:NetworkVideoTransmitter"
+	onvifDevice                  = "tds:Device"
+
+	// Default metadata version
+	defaultMetadataVersion = 1
+
+	// UDP buffer size
+	udpBufferSize = 8192
+
+	// Discovery response delay (random 0-500ms per spec)
+	maxResponseDelayMs = 500
+)
+
+// DiscoveryResponder handles WS-Discovery probe requests and responses.
+type DiscoveryResponder struct {
+	server          *Server
+	conn            *net.UDPConn
+	running         bool
+	mutex           sync.RWMutex
+	deviceUUID      string
+	metadataVersion int
+	scopes          []string
+	xAddrs          []string
+}
+
+// DiscoveryConfig contains configuration for the discovery responder.
+type DiscoveryConfig struct {
+	// NetworkInterface specifies which interface to listen on (empty = all)
+	NetworkInterface string
+	// Scopes contains ONVIF scope URIs
+	Scopes []string
+	// DeviceUUID is the unique device identifier (auto-generated if empty)
+	DeviceUUID string
+}
+
+// NewDiscoveryResponder creates a new WS-Discovery responder.
+func NewDiscoveryResponder(server *Server, config *DiscoveryConfig) (*DiscoveryResponder, error) {
+	if config == nil {
+		config = &DiscoveryConfig{}
+	}
+
+	// Generate device UUID if not provided
+	deviceUUID := config.DeviceUUID
+	if deviceUUID == "" {
+		deviceUUID = generateDeviceUUID()
+	}
+
+	// Build XAddrs (device service addresses)
+	xAddrs := buildXAddrs(server.config)
+
+	// Build scopes
+	scopes := config.Scopes
+	if len(scopes) == 0 {
+		scopes = buildDefaultScopes(server.config)
+	}
+
+	return &DiscoveryResponder{
+		server:          server,
+		deviceUUID:      deviceUUID,
+		metadataVersion: defaultMetadataVersion,
+		scopes:          scopes,
+		xAddrs:          xAddrs,
+	}, nil
+}
+
+// Start begins listening for WS-Discovery probe requests.
+func (d *DiscoveryResponder) Start(ctx context.Context) error {
+	d.mutex.Lock()
+	if d.running {
+		d.mutex.Unlock()
+		return fmt.Errorf("discovery responder already running")
+	}
+	d.running = true
+	d.mutex.Unlock()
+
+	// Create UDP socket listening on multicast port
+	conn, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4zero, Port: 3702})
+	if err != nil {
+		return fmt.Errorf("failed to listen on UDP port 3702: %w", err)
+	}
+	d.conn = conn
+
+	// Create packet conn for multicast operations
+	p := ipv4.NewPacketConn(conn)
+
+	// Join multicast group on all suitable interfaces
+	group := net.IPv4(239, 255, 255, 250)
+	interfaces, _ := net.Interfaces()
+	joinedCount := 0
+	for _, iface := range interfaces {
+		if iface.Flags&net.FlagUp == 0 {
+			continue
+		}
+		// Skip loopback but allow all other interfaces including VPN/tunnel
+		if iface.Flags&net.FlagLoopback != 0 {
+			continue
+		}
+		// Try to join even if FlagMulticast is not set (some interfaces report incorrectly)
+		if err := p.JoinGroup(&iface, &net.UDPAddr{IP: group}); err != nil {
+			log.Printf("Debug: failed to join multicast on %s: %v", iface.Name, err)
+		} else {
+			log.Printf("Debug: joined multicast on %s", iface.Name)
+			joinedCount++
+		}
+	}
+
+	if joinedCount == 0 {
+		log.Printf("Warning: failed to join multicast on any interface")
+	}
+
+	// Set read buffer size
+	if err := conn.SetReadBuffer(udpBufferSize); err != nil {
+		log.Printf("Warning: failed to set read buffer: %v", err)
+	}
+
+	// Send Hello message on startup
+	if err := d.sendHello(); err != nil {
+		log.Printf("Warning: failed to send Hello message: %v", err)
+	}
+
+	fmt.Printf("🔍 WS-Discovery responder started on %s\n", WSDiscoveryMulticastAddr)
+	fmt.Printf("   UUID: urn:uuid:%s\n", d.deviceUUID)
+	fmt.Printf("   XAddrs: %s\n", strings.Join(d.xAddrs, " "))
+
+	// Start listening goroutine
+	go d.listenLoop(ctx)
+
+	return nil
+}
+
+// Stop stops the discovery responder.
+func (d *DiscoveryResponder) Stop() error {
+	d.mutex.Lock()
+	defer d.mutex.Unlock()
+
+	if !d.running {
+		return nil
+	}
+
+	d.running = false
+
+	// Send Bye message before closing
+	if d.conn != nil {
+		_ = d.sendBye()
+		_ = d.conn.Close()
+	}
+
+	fmt.Println("🔍 WS-Discovery responder stopped")
+	return nil
+}
+
+// listenLoop continuously listens for probe requests.
+func (d *DiscoveryResponder) listenLoop(ctx context.Context) {
+	buffer := make([]byte, udpBufferSize)
+
+	for {
+		select {
+		case <-ctx.Done():
+			_ = d.Stop()
+			return
+		default:
+			// Set read deadline to allow periodic context checks
+			if err := d.conn.SetReadDeadline(time.Now().Add(time.Second)); err != nil {
+				continue
+			}
+
+			n, remoteAddr, err := d.conn.ReadFromUDP(buffer)
+			if err != nil {
+				if netErr, ok := err.(net.Error); ok && netErr.Timeout() {
+					continue // Timeout is expected, check context and continue
+				}
+				d.mutex.RLock()
+				running := d.running
+				d.mutex.RUnlock()
+				if !running {
+					return
+				}
+				continue
+			}
+
+			// Handle probe request
+			go d.handleProbe(buffer[:n], remoteAddr)
+		}
+	}
+}
+
+// handleProbe processes an incoming WS-Discovery probe request.
+func (d *DiscoveryResponder) handleProbe(data []byte, remoteAddr *net.UDPAddr) {
+	// Ignore packets from port 3702 (our own messages echoed back via multicast)
+	if remoteAddr.Port == 3702 {
+		return
+	}
+
+	log.Printf("🔍 Received UDP packet from %s (%d bytes)", remoteAddr, len(data))
+
+	// Parse the probe message
+	probe, err := parseProbeMessage(data)
+	if err != nil {
+		log.Printf("🔍 Not a valid probe message: %v", err)
+		return
+	}
+
+	log.Printf("🔍 Valid Probe received: MessageID=%s, Types=%s", probe.MessageID, probe.Types)
+
+	// Check if probe matches our device type
+	if !d.matchesProbe(probe) {
+		log.Printf("🔍 Probe does not match our device type")
+		return
+	}
+
+	log.Printf("🔍 Probe matches, preparing response...")
+
+	// Add small random delay per WS-Discovery spec (0-100ms for faster response)
+	delay := time.Duration(randInt(100)) * time.Millisecond
+	time.Sleep(delay)
+
+	// Build and send ProbeMatch response
+	response := d.buildProbeMatchResponse(probe.MessageID)
+
+	log.Printf("🔍 Sending ProbeMatch to %s (%d bytes)", remoteAddr, len(response))
+
+	// Create a new UDP socket to send response from the correct interface
+	// This ensures the response comes from the same network as the probe
+	respConn, err := net.DialUDP("udp4", nil, remoteAddr)
+	if err != nil {
+		log.Printf("Failed to create response socket: %v", err)
+		// Fallback to original method
+		if _, err := d.conn.WriteToUDP(response, remoteAddr); err != nil {
+			log.Printf("Failed to send ProbeMatch: %v", err)
+		}
+		return
+	}
+	defer respConn.Close()
+
+	if _, err := respConn.Write(response); err != nil {
+		log.Printf("Failed to send ProbeMatch: %v", err)
+	} else {
+		log.Printf("🔍 ProbeMatch sent successfully to %s from %s", remoteAddr, respConn.LocalAddr())
+	}
+}
+
+// matchesProbe checks if the probe request matches this device.
+func (d *DiscoveryResponder) matchesProbe(probe *wsDiscoveryProbe) bool {
+	// If no types specified, match all ONVIF devices
+	if probe.Types == "" {
+		return true
+	}
+
+	types := strings.ToLower(probe.Types)
+
+	// Match ONVIF device types
+	if strings.Contains(types, "networkvideotransmitter") ||
+		strings.Contains(types, "device") ||
+		strings.Contains(types, "networkvideoanalyzer") {
+		return true
+	}
+
+	return false
+}
+
+// sendHello sends a WS-Discovery Hello message to announce device presence.
+func (d *DiscoveryResponder) sendHello() error {
+	hello := d.buildHelloMessage()
+	return d.sendMulticast(hello)
+}
+
+// sendBye sends a WS-Discovery Bye message before shutting down.
+func (d *DiscoveryResponder) sendBye() error {
+	bye := d.buildByeMessage()
+	return d.sendMulticast(bye)
+}
+
+// sendMulticast sends a message to the WS-Discovery multicast address.
+func (d *DiscoveryResponder) sendMulticast(data []byte) error {
+	addr, err := net.ResolveUDPAddr("udp4", WSDiscoveryMulticastAddr)
+	if err != nil {
+		return err
+	}
+	_, err = d.conn.WriteToUDP(data, addr)
+	return err
+}
+
+// WS-Discovery XML structures
+
+type wsDiscoveryProbe struct {
+	MessageID string
+	Types     string
+	Scopes    string
+}
+
+type wsDiscoveryEnvelope struct {
+	XMLName xml.Name `xml:"Envelope"`
+	Header  struct {
+		// Support both namespaced and non-namespaced Action
+		Action    string `xml:"Action"`
+		MessageID string `xml:"MessageID"`
+		To        string `xml:"To"`
+		ReplyTo   struct {
+			Address string `xml:"Address"`
+		} `xml:"ReplyTo"`
+		RelatesTo string `xml:"RelatesTo"`
+	} `xml:"Header"`
+	Body struct {
+		Probe struct {
+			XMLName xml.Name `xml:"Probe"`
+			Types   string   `xml:"Types"`
+			Scopes  string   `xml:"Scopes"`
+		}
+		ProbeMatches struct {
+			ProbeMatch struct {
+				EndpointReference struct {
+					Address string `xml:"Address"`
+				} `xml:"EndpointReference"`
+				Types           string `xml:"Types"`
+				Scopes          string `xml:"Scopes"`
+				XAddrs          string `xml:"XAddrs"`
+				MetadataVersion int    `xml:"MetadataVersion"`
+			} `xml:"ProbeMatch"`
+		} `xml:"ProbeMatches"`
+	} `xml:"Body"`
+}
+
+// parseProbeMessage parses a WS-Discovery probe message.
+func parseProbeMessage(data []byte) (*wsDiscoveryProbe, error) {
+	xmlStr := string(data)
+
+	// Check if it's a Probe message by looking for the action in the raw XML
+	if !strings.Contains(xmlStr, "discovery/Probe") {
+		return nil, fmt.Errorf("not a Probe message")
+	}
+
+	// Extract MessageID using simple string parsing (handles namespace prefixes)
+	messageID := extractXMLValue(xmlStr, "MessageID")
+	if messageID == "" {
+		return nil, fmt.Errorf("no MessageID found")
+	}
+
+	// Extract Types if present
+	types := extractXMLValue(xmlStr, "Types")
+
+	return &wsDiscoveryProbe{
+		MessageID: messageID,
+		Types:     types,
+		Scopes:    extractXMLValue(xmlStr, "Scopes"),
+	}, nil
+}
+
+// extractXMLValue extracts a value from XML, handling namespace prefixes.
+func extractXMLValue(xml, tagName string) string {
+	// Look for patterns like <a:TagName>value</a:TagName> or <TagName>value</TagName>
+	patterns := []string{
+		":" + tagName + ">",
+		"<" + tagName + ">",
+		"<" + tagName + " ",
+	}
+
+	for _, pattern := range patterns {
+		idx := strings.Index(xml, pattern)
+		if idx == -1 {
+			continue
+		}
+
+		// Find the start of the value
+		start := idx + len(pattern)
+		if strings.HasSuffix(pattern, " ") {
+			// Handle attributes - find the closing >
+			closeIdx := strings.Index(xml[start:], ">")
+			if closeIdx == -1 {
+				continue
+			}
+			start = start + closeIdx + 1
+		}
+
+		// Find the end tag
+		endTag := "</" 
+		endIdx := strings.Index(xml[start:], endTag)
+		if endIdx == -1 {
+			continue
+		}
+
+		value := xml[start : start+endIdx]
+		// Clean up any nested tags
+		if closeIdx := strings.Index(value, "<"); closeIdx != -1 {
+			value = value[:closeIdx]
+		}
+		return strings.TrimSpace(value)
+	}
+	return ""
+}
+
+// buildProbeMatchResponse builds a WS-Discovery ProbeMatches response.
+// Note: gowvp/onvif uses etree with path "./Body/ProbeMatches/ProbeMatch/XAddrs"
+// which requires elements WITHOUT namespace prefixes in the local name.
+func (d *DiscoveryResponder) buildProbeMatchResponse(relatesToID string) []byte {
+	messageID := fmt.Sprintf("urn:uuid:%s", generateMessageUUID())
+
+	// Use default namespace for SOAP envelope to avoid prefix issues with etree parsing
+	response := fmt.Sprintf(`<?xml version="1.0" encoding="UTF-8"?>
+<Envelope xmlns="http://www.w3.org/2003/05/soap-envelope" xmlns:wsa="http://schemas.xmlsoap.org/ws/2004/08/addressing" xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery" xmlns:dn="http://www.onvif.org/ver10/network/wsdl">
+<Header>
+<wsa:Action>%s</wsa:Action>
+<wsa:MessageID>%s</wsa:MessageID>
+<wsa:RelatesTo>%s</wsa:RelatesTo>
+<wsa:To>%s</wsa:To>
+</Header>
+<Body>
+<ProbeMatches xmlns="http://schemas.xmlsoap.org/ws/2005/04/discovery">
+<ProbeMatch>
+<wsa:EndpointReference><wsa:Address>urn:uuid:%s</wsa:Address></wsa:EndpointReference>
+<Types xmlns:dp0="http://www.onvif.org/ver10/network/wsdl">dp0:NetworkVideoTransmitter</Types>
+<Scopes>%s</Scopes>
+<XAddrs>%s</XAddrs>
+<MetadataVersion>%d</MetadataVersion>
+</ProbeMatch>
+</ProbeMatches>
+</Body>
+</Envelope>`,
+		wsaProbeMatchAction,
+		messageID,
+		relatesToID,
+		wsaAnonymousAddr,
+		d.deviceUUID,
+		strings.Join(d.scopes, " "),
+		strings.Join(d.xAddrs, " "),
+		d.metadataVersion)
+
+	return []byte(response)
+}
+
+// buildHelloMessage builds a WS-Discovery Hello message.
+func (d *DiscoveryResponder) buildHelloMessage() []byte {
+	messageID := fmt.Sprintf("urn:uuid:%s", generateMessageUUID())
+
+	hello := fmt.Sprintf(`<?xml version="1.0" encoding="UTF-8"?>
+<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" 
+            xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing"
+            xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery"
+            xmlns:dn="http://www.onvif.org/ver10/network/wsdl"
+            xmlns:tds="http://www.onvif.org/ver10/device/wsdl">
+  <s:Header>
+    <a:Action s:mustUnderstand="1">%s</a:Action>
+    <a:MessageID>%s</a:MessageID>
+    <a:To s:mustUnderstand="1">urn:schemas-xmlsoap-org:ws:2005:04:discovery</a:To>
+  </s:Header>
+  <s:Body>
+    <d:Hello>
+      <a:EndpointReference>
+        <a:Address>urn:uuid:%s</a:Address>
+      </a:EndpointReference>
+      <d:Types>%s %s</d:Types>
+      <d:Scopes>%s</d:Scopes>
+      <d:XAddrs>%s</d:XAddrs>
+      <d:MetadataVersion>%d</d:MetadataVersion>
+    </d:Hello>
+  </s:Body>
+</s:Envelope>`,
+		wsaHelloAction,
+		messageID,
+		d.deviceUUID,
+		onvifNetworkVideoTransmitter,
+		onvifDevice,
+		strings.Join(d.scopes, " "),
+		strings.Join(d.xAddrs, " "),
+		d.metadataVersion)
+
+	return []byte(hello)
+}
+
+// buildByeMessage builds a WS-Discovery Bye message.
+func (d *DiscoveryResponder) buildByeMessage() []byte {
+	messageID := fmt.Sprintf("urn:uuid:%s", generateMessageUUID())
+
+	bye := fmt.Sprintf(`<?xml version="1.0" encoding="UTF-8"?>
+<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" 
+            xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing"
+            xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery">
+  <s:Header>
+    <a:Action s:mustUnderstand="1">%s</a:Action>
+    <a:MessageID>%s</a:MessageID>
+    <a:To s:mustUnderstand="1">urn:schemas-xmlsoap-org:ws:2005:04:discovery</a:To>
+  </s:Header>
+  <s:Body>
+    <d:Bye>
+      <a:EndpointReference>
+        <a:Address>urn:uuid:%s</a:Address>
+      </a:EndpointReference>
+    </d:Bye>
+  </s:Body>
+</s:Envelope>`,
+		wsaByeAction,
+		messageID,
+		d.deviceUUID)
+
+	return []byte(bye)
+}
+
+// Helper functions
+
+// generateDeviceUUID generates a random UUID for the device.
+func generateDeviceUUID() string {
+	b := make([]byte, 16)
+	_, _ = rand.Read(b)
+	// Set version (4) and variant (2) bits
+	b[6] = (b[6] & 0x0f) | 0x40
+	b[8] = (b[8] & 0x3f) | 0x80
+	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:])
+}
+
+// generateMessageUUID generates a random UUID for message IDs.
+func generateMessageUUID() string {
+	return generateDeviceUUID()
+}
+
+// randInt generates a random integer between 0 and max.
+func randInt(max int) int {
+	if max <= 0 {
+		return 0
+	}
+	b := make([]byte, 2)
+	_, _ = rand.Read(b)
+	return (int(b[0])<<8 | int(b[1])) % max
+}
+
+// buildXAddrs builds the XAddrs (device service URLs) from server config.
+func buildXAddrs(config *Config) []string {
+	// Get local IP addresses
+	localIPs := getLocalIPs()
+
+	var xAddrs []string
+	for _, ip := range localIPs {
+		addr := fmt.Sprintf("http://%s:%d%s/device_service", ip, config.Port, config.BasePath)
+		xAddrs = append(xAddrs, addr)
+	}
+
+	// If no local IPs found, use configured host
+	if len(xAddrs) == 0 {
+		host := config.Host
+		if host == "0.0.0.0" || host == "" {
+			host = "localhost"
+		}
+		xAddrs = append(xAddrs, fmt.Sprintf("http://%s:%d%s/device_service",
+			host, config.Port, config.BasePath))
+	}
+
+	return xAddrs
+}
+
+// buildDefaultScopes builds default ONVIF scopes from server config.
+func buildDefaultScopes(config *Config) []string {
+	return []string{
+		"onvif://www.onvif.org/type/video_encoder",
+		"onvif://www.onvif.org/type/ptz",
+		"onvif://www.onvif.org/Profile/Streaming",
+		fmt.Sprintf("onvif://www.onvif.org/name/%s", config.DeviceInfo.Model),
+		fmt.Sprintf("onvif://www.onvif.org/location/%s", "Virtual"),
+		fmt.Sprintf("onvif://www.onvif.org/hardware/%s", config.DeviceInfo.HardwareID),
+	}
+}
+
+// getLocalIPs returns all non-loopback IPv4 addresses.
+func getLocalIPs() []string {
+	var ips []string
+
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		return ips
+	}
+
+	for _, iface := range interfaces {
+		// Skip down, loopback, and non-multicast interfaces
+		if iface.Flags&net.FlagUp == 0 ||
+			iface.Flags&net.FlagLoopback != 0 {
+			continue
+		}
+
+		addrs, err := iface.Addrs()
+		if err != nil {
+			continue
+		}
+
+		for _, addr := range addrs {
+			var ip net.IP
+			switch v := addr.(type) {
+			case *net.IPNet:
+				ip = v.IP
+			case *net.IPAddr:
+				ip = v.IP
+			}
+
+			// Only IPv4, non-loopback
+			if ip == nil || ip.IsLoopback() || ip.To4() == nil {
+				continue
+			}
+
+			ips = append(ips, ip.String())
+		}
+	}
+
+	return ips
+}
+
+// GetDeviceUUID returns the device UUID.
+func (d *DiscoveryResponder) GetDeviceUUID() string {
+	return d.deviceUUID
+}
+
+// GetXAddrs returns the device XAddrs.
+func (d *DiscoveryResponder) GetXAddrs() []string {
+	return d.xAddrs
+}
+
+// GetScopes returns the device scopes.
+func (d *DiscoveryResponder) GetScopes() []string {
+	return d.scopes
+}
